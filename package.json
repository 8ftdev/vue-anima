{
  "name": "vue-anima",
  "version": "0.1.0",
  "description": "Tiny reactive goal-style animations for Vue and Vapor, powered by WAAPI.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vapor": {
      "types": "./dist/vapor.d.ts",
      "import": "./dist/vapor.js"
    },
    "./plugins/classes": {
      "types": "./dist/plugins/classes.d.ts",
      "import": "./dist/plugins/classes.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && vue-tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests/unit",
    "test:browser": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "size": "bun scripts/size.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run size && bun run test:package",
    "test:package": "bun test tests/package && tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck false dist/index.d.ts dist/vapor.d.ts dist/plugins/classes.d.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0 || ^3.6.0-0"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-sfc": "3.6.0-rc.9",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vue-stable": "npm:vue@3.5.43",
    "vue-tsc": "3.3.11",
    "vue": "3.6.0-rc.9"
  },
  "license": "MIT"
}
